# /etc/<name>/slack.env  (root:root 0600, inside /etc/<name>/ which is 0700)
# One KEY='value' per line. Services idle in waiting_for_secrets until every
# REPLACE_ME is filled in. Set values with `sudo <name>-set KEY`, never by
# pasting them on a command line or into chat.
#
# NEVER commit real values. This file is an example only.
#
# The MCP bearer is NOT an entry here. It is a separate file,
# /etc/<name>/mcp-bearer (root:root 0600, from `openssl rand -hex 32`),
# passed to the MCP service with LoadCredential=.

# Bot User OAuth Token (xoxb-...). Used by the relay and the MCP server.
SLACK_BOT_TOKEN='REPLACE_ME'
# App-level token with connections:write (xapp-...). Relay only (Socket Mode).
SLACK_APP_TOKEN='REPLACE_ME'
# The Grok Bot routine's "POST to" webhook URL. Relay only.
GROK_WEBHOOK_URL='REPLACE_ME'
# The routine's webhook key, without a "Bearer " prefix. Relay only.
GROK_WEBHOOK_KEY='REPLACE_ME'
# Comma-separated Slack member IDs whose pings trigger the routine, or '*' for
# every full member of the bot's own workspace (no bots, guests, deactivated
# or Slack Connect users). Relay only.
SLACK_ALLOWED_USERS='REPLACE_ME'

# Optional, coworker profile only (BOT_PROFILE=coworker in the units).
# Not secrets; can also be set as Environment= in the relay unit.
# PING_COALESCE_SECONDS='2.5'      quiet window after the last ping in a burst
# PING_COALESCE_MAX_SECONDS='5'    hard cap from the first ping
# PING_CHANNEL_TYPES='im,mpim'

# Optional, any profile. Not secrets; can also be Environment= lines in the relay unit.
# AUTO_JOIN_PUBLIC='0'             do not join public channels; the bot is only where it was invited
# PING_CHANNELS='C0123456789'      channels where every message is a ping, no mention needed

# Optional. Comma-separated Slack user IDs of OTHER BOTS whose mentions, DMs and
# DM/group-DM posts are forwarded like a human's ping (payload gets is_bot=true).
# All other bots stay filtered; the relay's own messages are never forwarded.
# SLACK_ALLOWED_BOTS='U0123456789'
# Loop guard: max forwards per allowlisted bot per thread per hour (drops are logged).
# SLACK_BOT_PINGS_PER_THREAD_HOUR='20'
