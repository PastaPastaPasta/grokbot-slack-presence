# /etc/<name>/slack.env  (root:root 0600, inside /etc/<name>/ which is 0700)
# One KEY='value' per line. Services idle in waiting_for_secrets until every
# REPLACE_ME is filled in. Set values with `sudo <name>-set KEY`, never by
# pasting them on a command line or into chat.
#
# NEVER commit real values. This file is an example only.
#
# The MCP bearer is NOT an entry here. It is a separate file,
# /etc/<name>/mcp-bearer (root:root 0600, from `openssl rand -hex 32`),
# passed to the MCP service with LoadCredential=.

# Bot User OAuth Token (xoxb-...). Used by the relay and the MCP server.
SLACK_BOT_TOKEN='REPLACE_ME'
# App-level token with connections:write (xapp-...). Relay only (Socket Mode).
SLACK_APP_TOKEN='REPLACE_ME'
# The Grok Bot routine's "POST to" webhook URL. Relay only.
GROK_WEBHOOK_URL='REPLACE_ME'
# The routine's webhook key, without a "Bearer " prefix. Relay only.
GROK_WEBHOOK_KEY='REPLACE_ME'
# Comma-separated Slack member IDs whose pings trigger the routine. Relay only.
SLACK_ALLOWED_USERS='REPLACE_ME'
